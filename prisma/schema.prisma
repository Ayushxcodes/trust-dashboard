generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id
  name                String
  email               String    @unique
  passwordHash        String
  role                String    // "USER" | "ADMIN"
  companyName         String
  corporateId         String
  createdAt           DateTime  @default(now())
  complianceDeadline  String?
  countdownDays       Int?
  avatarUrl           String?
  twoFactorSecret     String?
  twoFactorEnabled    Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
}

model DocumentTemplate {
  id          String   @id
  title       String
  description String
  fileUrl     String
  requiredFor String
  createdAt   DateTime @default(now())
}

model UserDocument {
  id              String    @id
  userId          String
  templateId      String
  uploadedFileUrl String
  fileName        String
  status          String    // "PENDING" | "UPLOADED" | "VERIFIED" | "REJECTED"
  adminRemark     String    @default("")
  uploadedAt      DateTime  @default(now())
  reviewedAt      DateTime?
}

model PipelineStage {
  id         String   @id
  userId     String
  stageName  String
  status     String   // "PENDING" | "IN_PROGRESS" | "COMPLETED"
  stageOrder Int
  adminNote  String   @default("")
  updatedAt  DateTime @default(now())
}

model AuditLog {
  id        String   @id
  adminId   String?
  userId    String?
  action    String
  createdAt DateTime @default(now())
}

model SystemMessage {
  id           String   @id
  senderId     String
  targetUserId String   // "all" or userId
  messageText  String
  type         String   // "INFO" | "WARNING" | "CRITICAL"
  createdAt    DateTime @default(now())
}

model GrievanceRequest {
  id                 String   @id
  ticketId           String   @unique
  investorName       String
  email              String
  phone              String
  folioOrPan         String
  companyName        String
  category           String
  description        String
  status             String   @default("IN_PROCESSING") // "RECEIVED" | "IN_PROCESSING" | "ESCALATED_LEVEL2" | "RESOLVED"
  remarks            String   @default("Request logged in statutory register. Level 1 RTA officer actively processing files.")
  submittedOn        DateTime @default(now())
  expectedResolution String   @default("7 Business Days (Level 1 Resolution)")
  updatedAt          DateTime @updatedAt
}

model ServicedCompany {
  id           String   @id
  name         String
  cin          String
  isin         String
  type         String   @default("Unlisted Public Equity") // "Unlisted Public Equity" | "Listed Equity" | "Debt / Bonds" | "Preference Shares"
  depositories String   @default("NSDL, CDSL")
  status       String   @default("Active servicing") // "Active servicing" | "ISIN Activated"
  nodalContact String
  createdAt    DateTime @default(now())
}
